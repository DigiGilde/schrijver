# OpenID Connect discovery URL of the identity provider (…/.well-known/openid-configuration)
OIDC_DISCOVERY_URL=
# OIDC client id registered for Schrijver
OIDC_CLIENT_ID=
# OIDC client secret
OIDC_CLIENT_SECRET=
# Secret used to sign and encrypt session cookies (long random string)
SESSION_SECRET=
# GitHub App id
GITHUB_APP_ID=
# GitHub App private key (PEM, newlines as \n)
GITHUB_APP_PRIVATE_KEY=
# GitHub App client id (user authorization, account linking)
GITHUB_APP_CLIENT_ID=
# GitHub App client secret (user authorization, account linking)
GITHUB_APP_CLIENT_SECRET=
# Public base URL of Schrijver, used for the OAuth redirect_uri
ORIGIN=
# Secret used to verify GitHub webhook signatures
GITHUB_WEBHOOK_SECRET=
# Repository (owner/name) that holds the site configuration
GITHUB_CONFIG_REPO=
# Base URL of the VLAM API used for text suggestions
VLAM_API_URL=
# VLAM API key (prepaid)
VLAM_KEY_PREPAID=
# VLAM model name
VLAM_MODEL=
# Secret used to derive pseudonyms for users
PSEUDONYM_SECRET=
# Connection string of the database
DATABASE_SERVER_FULL=
# Port the server listens on
PORT=3000
